---
import Icon from './Icon.astro';
import { nav, type NavId } from '../content/site-content';
interface Props { current: NavId }
const { current } = Astro.props;
const items = nav.filter((n) => n.id !== 'launchpad');
---
<nav class="bottom-nav" aria-label="Quick">
  <ul role="list">
    {items.map((item) => (
      <li>
        <a href={item.href} aria-current={item.id === current ? 'page' : undefined}>
          <Icon name={item.icon} />
          <span>{item.short}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .bottom-nav {
    position: fixed; inset: auto 0 0 0; z-index: 45;
    background: #fff;
    border-top: 1px solid var(--c-border);
    box-shadow: 0 -8px 24px -18px rgb(16 27 63 / 0.3);
    padding-bottom: var(--safe-b);
  }
  ul { display: grid; grid-template-columns: repeat(4, 1fr); height: var(--bottom-nav-h); max-width: 560px; margin-inline: auto; padding-inline: 8px; }
  a {
    height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
    font-size: 0.6875rem; font-weight: 700; color: var(--c-ink-3);
    border-radius: var(--r-md);
    position: relative;
  }
  a :global(svg) { width: 22px; height: 22px; }
  a[aria-current='page'] { color: var(--c-cobalt); }
  a[aria-current='page']::before {
    content: ''; position: absolute; top: 0; width: 28px; height: 3px; border-radius: 0 0 3px 3px; background: var(--c-cobalt);
  }
  a:active { background: var(--c-pale); }
  @media (min-width: 900px) { .bottom-nav { display: none; } }
</style>
