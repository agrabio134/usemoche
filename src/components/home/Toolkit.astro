---
import Icon from '../Icon.astro';
import CommandSheet from '../CommandSheet.astro';
import SignalReply from '../SignalReply.astro';
import CheckReply from '../CheckReply.astro';
import { products } from '../../content/site-content';
import { brand, copyTradingAccess } from '../../config/site';
const minShort = `${copyTradingAccess.minimumHolding / 1_000_000}M`;
---
<section class="toolkit" id="tools" aria-labelledby="toolkit-title">
  <div class="container">
    <div class="tk__head">
      <h2 id="toolkit-title" class="h2">Your research toolkit</h2>
      <p>Powerful tools to help you navigate crypto with more clarity.</p>
    </div>

    <ul role="list" class="tk">
      {products.map((p) => (
        <li>
          <a href={p.href} class:list={['tk__item', `tk__item--${p.id}`]}>
            <span class:list={['tk__ic', { 'tk__ic--solid': p.id === 'signal' }]}><Icon name={p.icon} /></span>
            <span class="tk__body">
              <span class="tk__name">{p.name}</span>
              <span class="tk__desc">{p.short}</span>
            </span>
            {'badge' in p && (
              <span class:list={['tk__badge', `tk__badge--${p.badge.tone}`]}>
                {p.badge.tone === 'holder' ? (<><strong>{minShort} MOCHE</strong><span>for free access</span></>) : p.badge.text}
              </span>
            )}
            <Icon name="chevron-right" class="tk__chev" />
          </a>
        </li>
      ))}
    </ul>

    <a href="/copy-trading/#access" class="hbar">
      <span class="hbar__ic"><Icon name="coins" /></span>
      <span class="hbar__sep" aria-hidden="true"></span>
      <span class="hbar__t">Hold {minShort} MOCHE. <span>Unlock free copy trading.</span></span>
      <Icon name="chevron-right" class="hbar__chev" />
    </a>
  </div>
</section>

<CommandSheet
  id="sheet-signal"
  title="Signal Bot"
  icon="signal"
  command={brand.commands.signal}
  steps={[
    'Find a post on X about the token you’re interested in.',
    `Reply with ${brand.commands.signal}.`,
    'Moche replies with a Buy / Sell / Wait assessment, reasons, confidence and risk context.',
  ]}
  note="Signals are research, not instructions. Moche never places trades for you."
  href="/products/#signal"
>
  <SignalReply compact />
</CommandSheet>
<CommandSheet
  id="sheet-check"
  title="Token & Wallet Check"
  icon="shield"
  command={brand.commands.check}
  steps={[
    'Find a post on X about a token or project.',
    `Reply with ${brand.commands.check}.`,
    'Moche replies with a risk estimate, its confidence, and the key concerns with evidence.',
  ]}
  note="A low risk estimate is not a guarantee of safety. If the token can’t be identified, Moche asks for its contract address."
  href="/products/#check"
>
  <CheckReply compact />
</CommandSheet>

<style>
  .toolkit { padding: 32px 0 var(--section-y); background: linear-gradient(180deg, #f4f9ff 0%, var(--c-pale) 60%, #fff 100%); }
  .tk__head { margin-bottom: 16px; }
  .tk__head .h2 { font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.375rem); }
  .tk__head p { margin-top: 4px; color: var(--c-ink-2); font-size: var(--fs-sm); line-height: 1.45; }

  .tk { display: grid; gap: 10px; }
  .tk__item {
    display: flex; align-items: center; gap: 12px;
    min-height: 72px; padding: 12px 12px 12px 12px;
    background: #fff; border: 1px solid var(--c-border); border-radius: var(--r-lg);
    box-shadow: var(--sh-1);
    transition: border-color var(--dur-1), box-shadow var(--dur-2);
  }
  .tk__item:hover { border-color: #c8d6ec; box-shadow: var(--sh-2); }
  .tk__item--launchpad .tk__ic { background: var(--c-tint); }
  .tk__ic { display: grid; place-items: center; flex: none; width: 46px; height: 46px; border-radius: 13px; background: var(--c-tint); color: var(--c-cobalt); }
  .tk__ic :global(svg) { width: 24px; height: 24px; }
  .tk__ic--solid { background: var(--c-cobalt); color: #fff; }
  .tk__body { flex: 1; min-width: 0; display: grid; gap: 2px; }
  .tk__name { font-weight: 800; font-size: 0.9375rem; letter-spacing: -0.01em; color: var(--c-navy); }
  .tk__desc { font-size: 0.8125rem; color: var(--c-ink-2); line-height: 1.4; }
  .tk__ic--solid { background: var(--c-tint); color: var(--c-cobalt); }
  .tk__badge { flex: none; display: grid; text-align: center; line-height: 1.2; padding: 5px 8px; border-radius: 9px; font-size: 0.625rem; font-weight: 600; }
  .tk__badge--holder { background: var(--c-tint); color: var(--c-cobalt-press); }
  .tk__badge--holder strong { font-size: 0.75rem; font-weight: 800; }
  .tk__badge--soon { background: #eef1f6; color: var(--c-ink-2); border: 1px solid var(--c-border); font-size: 0.6875rem; padding: 6px 9px; }
  .tk :global(.tk__chev) { width: 18px; height: 18px; flex: none; color: var(--c-ink-3); transition: transform var(--dur-2) var(--ease), color var(--dur-1); }
  .tk__item:hover :global(.tk__chev) { transform: translateX(3px); color: var(--c-cobalt); }

  .hbar {
    margin-top: 16px;
    display: flex; align-items: center; gap: 14px;
    min-height: 60px; padding: 10px 18px;
    border-radius: var(--r-lg); color: #fff;
    background:
      radial-gradient(400px 120px at 0% 0%, rgb(36 85 245 / 0.45), transparent 70%),
      var(--c-navy);
    box-shadow: var(--sh-2);
  }
  .hbar:hover { background: radial-gradient(400px 120px at 0% 0%, rgb(36 85 245 / 0.6), transparent 70%), var(--c-navy); }
  .hbar:focus-visible { box-shadow: var(--focus-ring); }
  .hbar__ic { display: grid; color: var(--c-sky); }
  .hbar__ic :global(svg) { width: 22px; height: 22px; }
  .hbar__sep { width: 1px; height: 24px; background: rgb(255 255 255 / 0.2); }
  .hbar__t { flex: 1; font-weight: 600; font-size: var(--fs-sm); line-height: 1.35; }
  .hbar__t span { color: var(--c-sky); }
  .hbar :global(.hbar__chev) { width: 20px; height: 20px; flex: none; }

  @media (min-width: 900px) {
    .toolkit { padding-top: 40px; }
    .tk__head { margin-bottom: 20px; }
    .tk__head p { font-size: var(--fs-lg); }
    .tk__badge { font-size: 0.6875rem; padding: 6px 10px; }
    .tk__badge--holder strong { font-size: 0.8125rem; }
    .tk { grid-template-columns: 1fr 1fr; gap: 16px; }
    .tk__item { min-height: 92px; padding: 18px 20px 18px 18px; gap: 18px; }
    .tk__ic { width: 56px; height: 56px; border-radius: 16px; }
    .tk__ic--solid { background: var(--c-cobalt); color: #fff; }
    .tk__desc { font-size: var(--fs-sm); }
    .tk__head p { font-size: var(--fs-lg); }
    .tk__badge { font-size: 0.6875rem; padding: 6px 10px; }
    .tk__badge--holder strong { font-size: 0.8125rem; }
    .tk__ic :global(svg) { width: 26px; height: 26px; }
    .tk__name { font-size: 1.0625rem; }
    .hbar { justify-content: center; min-height: 64px; margin-top: 20px; }
    .hbar__t { flex: 0 1 auto; font-size: var(--fs-md); }
    .hbar :global(.hbar__chev) { margin-left: auto; }
  }
</style>
