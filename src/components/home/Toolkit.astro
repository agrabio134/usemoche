---
import Icon from '../Icon.astro';
import CommandSheet from '../CommandSheet.astro';
import { products } from '../../content/site-content';
import { brand } from '../../config/site';
---
<section class="section toolkit" id="tools" aria-labelledby="toolkit-title">
  <div class="container">
    <div class="section-head">
      <h2 id="toolkit-title" class="h2">Your research toolkit</h2>
      <p class="lead">Four tools that help you look before you leap, from a quick check in a reply to following wallets you trust.</p>
    </div>

    <ul role="list" class="tk">
      {products.map((p) => (
        <li class:list={['tk__item', `tk__item--${p.id}`]}>
          <span class:list={['icon-tile', { 'icon-tile--solid': p.id === 'signal' || p.id === 'check' }]}><Icon name={p.icon} /></span>
          <div class="tk__body">
            <h3 class="h3"><a href={p.href} class="tk__link">{p.name}</a></h3>
            <p>{p.summary}</p>
            <div class="tk__meta">
              {'command' in p && (
                <>
                  <span class="cmd">{p.command}</span>
                  <button type="button" class="tk__use" data-sheet-open={`sheet-${p.id}`} aria-label={`How to use ${p.command}`}>
                    <Icon name="copy" size={16} /> Use command
                  </button>
                </>
              )}
              {'badge' in p && <span class:list={['badge', `badge--${p.badge.tone}`]}>{p.badge.tone === 'holder' && <Icon name="coins" />}{p.badge.text}</span>}
            </div>
          </div>
          <Icon name="chevron-right" class="tk__chev" />
        </li>
      ))}
    </ul>
  </div>
</section>

<CommandSheet
  id="sheet-signal"
  title="Signal Bot"
  icon="signal"
  command={brand.commands.signal}
  steps={[
    'Find a post on X about the token you’re interested in.',
    `Reply with ${brand.commands.signal}.`,
    'Moche replies with a Buy / Sell / Wait assessment, reasons, confidence and risk context.',
  ]}
  note="Signals are research, not instructions. Moche never places trades for you."
  href="/products/#signal"
/>
<CommandSheet
  id="sheet-check"
  title="Token & Wallet Check"
  icon="shield"
  command={brand.commands.check}
  steps={[
    'Find a post on X about a token or project.',
    `Reply with ${brand.commands.check}.`,
    'Moche replies with a risk estimate, its confidence, and the key concerns with evidence.',
  ]}
  note="A low risk estimate is not a guarantee of safety. If the token can’t be identified, Moche asks for its contract address."
  href="/products/#check"
/>

<style>
  .toolkit { padding-top: clamp(40px, 3rem + 2vw, 80px); }
  .tk { display: grid; gap: 12px; }
  .tk__item {
    position: relative;
    display: flex; gap: 14px; align-items: flex-start;
    padding: 16px; background: #fff;
    border: 1px solid var(--c-border); border-radius: var(--r-lg);
    box-shadow: var(--sh-1);
    transition: border-color var(--dur-1), box-shadow var(--dur-2), transform var(--dur-2) var(--ease);
  }
  .tk__item:hover { border-color: #c8d6ec; box-shadow: var(--sh-2); }
  .tk__item:has(.tk__link:focus-visible) { box-shadow: var(--focus-ring); }
  .tk__link { color: inherit; }
  .tk__link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .tk__link:focus-visible { box-shadow: none; }
  .tk__body { flex: 1; min-width: 0; display: grid; gap: 4px; }
  .tk__body p { font-size: var(--fs-sm); color: var(--c-ink-2); line-height: 1.5; }
  .tk__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 8px; }
  .tk__use {
    position: relative; z-index: 1;
    display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 12px;
    font-size: var(--fs-xs); font-weight: 700; color: var(--c-cobalt);
    border-radius: var(--r-pill); border: 1px solid var(--c-tint-2); background: #fff;
  }
  .tk__use:hover { background: var(--c-pale); }
  .tk :global(.tk__chev) { width: 20px; height: 20px; color: var(--c-ink-3); flex: none; align-self: center; transition: transform var(--dur-2) var(--ease), color var(--dur-1); }
  .tk__item:hover :global(.tk__chev) { transform: translateX(3px); color: var(--c-cobalt); }
  .tk__item--launchpad { background: var(--c-surface-2); }

  @media (min-width: 760px) {
    .tk { grid-template-columns: 1fr 1fr; gap: 16px; }
    .tk__item { padding: 22px; gap: 18px; }
    .tk .icon-tile { width: 56px; height: 56px; border-radius: 16px; }
    .tk .icon-tile :global(svg) { width: 26px; height: 26px; }
  }
</style>
