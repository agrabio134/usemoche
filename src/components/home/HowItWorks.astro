---
import Icon from '../Icon.astro';
import { howItWorks } from '../../content/site-content';
import { brand } from '../../config/site';
---
<section class="section section--tint how" id="how-it-works" aria-labelledby="how-title">
  <div class="container split">
    <div>
      <div class="section-head">
        <span class="eyebrow"><Icon name="at" size={16} /> Works in your replies</span>
        <h2 id="how-title" class="h2">How it works</h2>
        <p class="lead">No app to install. Moche works right where you already read about tokens.</p>
      </div>
      <ol role="list" class="steps">
        {howItWorks.map((s, i) => (
          <li>
            <span class="steps__n" aria-hidden="true">{i + 1}</span>
            <div>
              <h3 class="h3">{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="cmds">
        <span class="muted small">Commands</span>
        <span class="cmd">{brand.commands.signal}</span>
        <span class="cmd">{brand.commands.check}</span>
      </div>
    </div>

    <figure class="thread" aria-label="Example of a reply thread (illustrative)">
      <span class="badge badge--preview thread__badge">Illustrative preview</span>
      <div class="msg">
        <span class="av av--a" aria-hidden="true">A</span>
        <div class="msg__body">
          <p class="msg__who">A post you’re reading</p>
          <p class="msg__text">Has anyone looked into $EXAMPLE yet? Seeing it everywhere today.</p>
        </div>
      </div>
      <div class="msg msg--reply">
        <span class="av av--you" aria-hidden="true">You</span>
        <div class="msg__body">
          <p class="msg__who">Your reply</p>
          <p class="msg__text msg__text--cmd">{brand.commands.check}</p>
        </div>
      </div>
      <div class="msg msg--reply msg--moche">
        <img src="/images/moche-avatar-64.webp" width="40" height="40" alt="" class="av" loading="lazy" decoding="async" />
        <div class="msg__body">
          <p class="msg__who">Moche <span>@usemoche</span></p>
          <div class="mini">
            <p><span class="mini__k">Risk estimate</span><strong>Moderate</strong></p>
            <p><span class="mini__k">Confidence</span><strong>High</strong></p>
          </div>
          <p class="msg__text">Holder concentration and recent exchange transfers are worth a look. Here’s the evidence for each…</p>
        </div>
      </div>
      <figcaption class="thread__cap">
        <Icon name="info" size={16} /> Example only. Not a real token or a real analysis.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .steps { display: grid; gap: var(--s-5); counter-reset: s; }
  .steps li { display: flex; gap: 16px; align-items: flex-start; }
  .steps__n {
    display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 12px;
    background: #fff; border: 1.5px solid var(--c-tint-2); color: var(--c-cobalt); font-weight: 800;
  }
  .steps p { color: var(--c-ink-2); font-size: var(--fs-md); margin-top: 2px; }
  .cmds { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: var(--s-7); }
  .cmds .cmd { font-size: 1rem; padding: 6px 12px; background: #fff; }

  .thread {
    position: relative;
    background: #fff; border: 1px solid var(--c-border); border-radius: var(--r-xl);
    box-shadow: var(--sh-3); padding: var(--s-5);
    display: grid; gap: 0;
  }
  .thread__badge { position: absolute; top: 16px; right: 16px; }
  .msg { display: flex; gap: 12px; padding: 14px 0; position: relative; }
  .msg + .msg { border-top: 1px solid var(--c-border); }
  .msg--reply { padding-left: 20px; }
  .msg--reply::before { content: ''; position: absolute; left: 4px; top: 0; bottom: 50%; width: 12px; border-left: 2px solid var(--c-border); border-bottom: 2px solid var(--c-border); border-bottom-left-radius: 10px; }
  .av { width: 40px; height: 40px; border-radius: 50%; flex: none; display: grid; place-items: center; font-weight: 800; font-size: var(--fs-xs); }
  .av--a { background: #e8ecf4; color: var(--c-ink-2); font-size: var(--fs-md); }
  .av--you { background: var(--c-navy); color: #fff; }
  .msg__body { min-width: 0; display: grid; gap: 6px; }
  .msg__who { font-size: var(--fs-sm); font-weight: 700; padding-right: 120px; }
  .msg--reply .msg__who { padding-right: 0; }
  .msg__who span { color: var(--c-ink-3); font-weight: 500; }
  .msg__text { font-size: var(--fs-md); color: var(--c-ink-2); line-height: 1.5; }
  .msg__text--cmd { font-family: var(--font-mono); font-weight: 700; font-size: 1.125rem; color: var(--c-cobalt); }
  .mini { display: flex; flex-wrap: wrap; gap: 8px; }
  .mini p { display: inline-flex; gap: 8px; align-items: baseline; padding: 6px 10px; border-radius: 10px; background: var(--c-surface-2); border: 1px solid var(--c-border); font-size: var(--fs-sm); }
  .mini__k { color: var(--c-ink-3); font-size: var(--fs-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .thread__cap { display: flex; gap: 6px; align-items: center; margin-top: 8px; padding-top: 12px; border-top: 1px dashed var(--c-border); font-size: var(--fs-xs); color: var(--c-ink-3); }
  @media (min-width: 640px) { .thread { padding: var(--s-7); } .thread__badge { top: 24px; right: 24px; } }
</style>
