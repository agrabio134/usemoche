---
interface Props { href?: string; tone?: 'dark' | 'light'; size?: 'md' | 'sm' }
const { href = '/', tone = 'dark', size = 'md' } = Astro.props;
---
<a href={href} class:list={['logo', `logo--${tone}`, `logo--${size}`]} aria-label="usemoche home">
  <img
    src="/images/moche-avatar-64.webp"
    srcset="/images/moche-avatar-64.webp 64w, /images/moche-avatar-128.webp 128w"
    sizes="36px"
    width="36"
    height="36"
    alt=""
    class="logo__avatar"
    decoding="async"
  />
  <span class="logo__word" aria-hidden="true">use<span>moche</span></span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; border-radius: var(--r-pill); padding: 2px 6px 2px 2px; }
  .logo__avatar {
    width: 36px; height: 36px; border-radius: 50%;
    box-shadow: 0 0 0 2px #fff, 0 0 0 3px var(--c-tint-2);
    background: var(--c-cobalt);
  }
  .logo__word {
    font-family: var(--font-brand);
    font-weight: 900;
    font-size: 1.375rem;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--c-navy);
    padding-bottom: 2px;
  }
  .logo__word span { color: var(--c-cobalt); }
  .logo--light .logo__word { color: #fff; }
  .logo--light .logo__word span { color: var(--c-sky); }
  .logo--light .logo__avatar { box-shadow: 0 0 0 2px rgb(255 255 255 / 0.25); }
  .logo--sm .logo__word { font-size: 1.25rem; }
  .logo--sm .logo__avatar { width: 32px; height: 32px; }
</style>
