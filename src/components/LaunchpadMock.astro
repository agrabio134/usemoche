---
import Icon from './Icon.astro';
import MocheEmpty from './MocheEmpty.astro';
interface Props { idPrefix?: string }
const { idPrefix = 'lp' } = Astro.props;
---
<div class="lp card" aria-label="Moche Launchpad concept preview">
  <div class="lp__bar">
    <span class="lp__title"><Icon name="rocket" size={18} /> Moche Launchpad</span>
    <span class="badge badge--soon"><Icon name="clock" /> Coming Soon</span>
  </div>

  <div class="lp__grid">
    <form class="lp__create" aria-describedby={`${idPrefix}-note`} onsubmit="return false">
      <p class="lp__h">Create a token</p>
      <fieldset disabled>
        <legend class="sr-only">Token details (disabled until launch)</legend>
        <div class="lp__img" aria-hidden="true"><Icon name="image" /></div>
        <div class="lp__fields">
          <label>
            <span>Name</span>
            <input type="text" placeholder="e.g. Moon Mochi" />
          </label>
          <label>
            <span>Ticker</span>
            <input type="text" placeholder="e.g. MOCHI" />
          </label>
        </div>
        <label class="lp__full">
          <span>Description</span>
          <input type="text" placeholder="One line about your token" />
        </label>
        <button type="button" class="btn btn--primary btn--block" aria-disabled="true" disabled>
          <Icon name="lock" /> Opens at launch
        </button>
      </fieldset>
      <p id={`${idPrefix}-note`} class="lp__note">Concept preview. Creation isn’t available yet.</p>
    </form>

    <div class="lp__discover">
      <div class="lp__dh">
        <p class="lp__h">Discover</p>
        <div class="lp__chips" aria-hidden="true">
          <span class="is-on">New</span><span>Trending</span>
        </div>
      </div>
      <MocheEmpty title="No tokens yet" text="New launches will show up here once Moche Launchpad opens." />
    </div>
  </div>
</div>

<style>
  .lp { container-type: inline-size; padding: var(--s-4); box-shadow: var(--sh-3); border-radius: var(--r-xl); display: grid; gap: var(--s-4); }
  .lp__bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 4px 4px 0; }
  .lp__title { display: inline-flex; align-items: center; gap: 8px; font-weight: 800; color: var(--c-navy); }
  .lp__title :global(svg) { color: var(--c-cobalt); }
  .lp__grid { display: grid; gap: var(--s-3); }
  .lp__create, .lp__discover { border: 1px solid var(--c-border); border-radius: var(--r-lg); padding: var(--s-4); background: var(--c-surface-2); }
  .lp__h { font-size: var(--fs-sm); font-weight: 800; margin-bottom: var(--s-3); }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: 64px 1fr; gap: 10px; min-width: 0; }
  .lp__img { width: 64px; height: 64px; border-radius: 16px; border: 1.5px dashed #c3cfe2; display: grid; place-items: center; color: var(--c-ink-3); background: #fff; }
  .lp__fields { display: grid; gap: 8px; min-width: 0; }
  .lp__full, fieldset .btn { grid-column: 1 / -1; }
  label { display: grid; gap: 4px; min-width: 0; }
  label span { font-size: var(--fs-xs); font-weight: 700; color: var(--c-ink-3); }
  input {
    width: 100%; min-width: 0; height: 40px; padding: 0 12px; border-radius: var(--r-sm);
    border: 1px solid var(--c-border); background: #fff; font-size: var(--fs-sm);
  }
  input:disabled { color: var(--c-ink-3); cursor: not-allowed; }
  input::placeholder { color: #8d99b3; }
  .lp__note { margin-top: 10px; font-size: var(--fs-xs); color: var(--c-ink-3); }
  .lp__dh { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .lp__dh .lp__h { margin-bottom: 0; }
  .lp__chips { display: inline-flex; gap: 4px; }
  .lp__chips span { font-size: var(--fs-xs); font-weight: 700; padding: 4px 10px; border-radius: 999px; color: var(--c-ink-3); border: 1px solid var(--c-border); background: #fff; }
  .lp__chips .is-on { color: var(--c-cobalt); border-color: var(--c-tint-2); background: var(--c-pale); }
  @media (min-width: 640px) { .lp { padding: var(--s-5); } }
  @container (min-width: 600px) { .lp__grid { grid-template-columns: 1.1fr 0.9fr; } }
</style>
