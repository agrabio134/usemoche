---
/** Small Moche appearance for empty states. */
interface Props { title: string; text: string }
const { title, text } = Astro.props;
---
<div class="empty">
  <img src="/images/moche-wave-360.webp" width="88" height="87" alt="" loading="lazy" decoding="async" />
  <p class="empty__t">{title}</p>
  <p class="empty__x">{text}</p>
  <slot />
</div>

<style>
  .empty { display: grid; justify-items: center; text-align: center; gap: 4px; padding: 20px 12px 16px; }
  .empty img { width: 88px; height: auto; margin-bottom: 6px; border-bottom: 2px solid var(--c-border); }
  .empty__t { font-weight: 800; font-size: var(--fs-sm); }
  .empty__x { font-size: var(--fs-xs); color: var(--c-ink-3); max-width: 28ch; line-height: 1.5; }
</style>
