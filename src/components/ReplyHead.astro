---
/** Header row of an illustrative Moche reply. */
---
<div class="rh">
  <img src="/images/moche-avatar-64.webp" width="32" height="32" alt="" class="rh__av" loading="lazy" decoding="async" />
  <div class="rh__who">
    <strong>Moche</strong>
    <span>@usemoche</span>
  </div>
  <span class="badge badge--preview">Illustrative preview</span>
</div>

<style>
  .rh { display: flex; align-items: center; gap: 10px; }
  .rh__av { width: 32px; height: 32px; border-radius: 50%; }
  .rh__who { display: grid; line-height: 1.2; }
  .rh__who strong { font-size: var(--fs-sm); }
  .rh__who span { font-size: var(--fs-xs); color: var(--c-ink-3); }
  .rh .badge { margin-left: auto; }
</style>
