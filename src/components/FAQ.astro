---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[]; title?: string; id?: string; intro?: string }
const { items, title = 'Frequently asked questions', id = 'faq', intro } = Astro.props;
---
<section class="section faq" id={id} aria-labelledby={`${id}-title`}>
  <div class="container faq__wrap">
    <div class="section-head">
      <h2 id={`${id}-title`} class="h2">{title}</h2>
      {intro && <p class="lead">{intro}</p>}
    </div>
    <div class="faq__list">
      {items.map((item, i) => (
        <details class="faq__item" name={`${id}-group`} open={i === 0 ? true : undefined}>
          <summary>
            <span>{item.q}</span>
            <span class="faq__icon" aria-hidden="true"><Icon name="chevron-down" /></span>
          </summary>
          <div class="faq__a"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__wrap { display: grid; gap: var(--s-6); }
  .faq__list { display: grid; gap: 10px; }
  .faq__item { background: #fff; border: 1px solid var(--c-border); border-radius: var(--r-lg); transition: border-color var(--dur-1), box-shadow var(--dur-2); }
  .faq__item[open] { border-color: var(--c-tint-2); box-shadow: var(--sh-2); }
  summary {
    list-style: none; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    min-height: 60px; padding: 14px 18px;
    font-weight: 700; font-size: var(--fs-md); line-height: 1.4;
    border-radius: var(--r-lg);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--c-cobalt); }
  .faq__icon { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--c-surface-2); flex: none; color: var(--c-ink-2); transition: transform var(--dur-2) var(--ease), background-color var(--dur-1); }
  .faq__icon :global(svg) { width: 18px; height: 18px; }
  .faq__item[open] .faq__icon { transform: rotate(180deg); background: var(--c-tint); color: var(--c-cobalt); }
  .faq__a { padding: 0 18px 18px; color: var(--c-ink-2); line-height: 1.65; max-width: 68ch; }
  .faq__item[open] .faq__a { animation: faq-in var(--dur-2) var(--ease); }
  @keyframes faq-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  @media (min-width: 960px) {
    .faq__wrap { grid-template-columns: 0.8fr 1.2fr; gap: var(--s-10); align-items: start; }
    .faq__wrap .section-head { position: sticky; top: calc(var(--header-h) + 32px); }
  }
</style>
