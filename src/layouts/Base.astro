---
import '../styles/global.css';
import '../styles/sheet.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import type { NavId } from '../content/site-content';

interface Props { title: string; description: string; current: NavId; preloadHero?: boolean }
const { title, description, current, preloadHero = false } = Astro.props;
const fullTitle = current === 'home' ? title : `${title} · usemoche`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2455F5" />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/og-image.jpg", Astro.site ?? Astro.url).href} />
    <meta name="twitter:site" content="@usemoche" />
    <meta name="twitter:card" content="summary_large_image" />
    {preloadHero && (
      <>
        <link rel="preload" as="image" type="image/webp" media="(max-width: 899.98px)"
          imagesrcset="/images/moche-peek-m-240.webp 240w, /images/moche-peek-m-400.webp 400w" imagesizes="200px" fetchpriority="high" />
        <link rel="preload" as="image" type="image/webp" media="(min-width: 900px)"
          imagesrcset="/images/moche-hero-d-640.webp 640w, /images/moche-hero-d-960.webp 960w" imagesizes="460px" fetchpriority="high" />
      </>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <BottomNav current={current} />
    <script>
      import '../scripts/ui.ts';
    </script>
  </body>
</html>
