---
import Base from '../layouts/Base.astro';
import Launchpad from '../launchpad/Launchpad';
---
<Base
  title="Moche Launchpad"
  description="MochePad: launch a token on Solana, Elysium or Robinhood Chain. Bonding curves paired with HYPE, SOL, ETH, USDC or tokenized stocks, graduating into permanently locked liquidity. Plus callouts from $MOCHE holders."
  current="launchpad"
>
  <Launchpad client:only="react">
    <div slot="fallback" class="lp-loading">
      <img src="/images/moche-wave-360.webp" width="96" height="95" alt="" />
      <p>Loading the launchpad…</p>
      <noscript><p>The launchpad needs JavaScript to connect a wallet and read markets on-chain.</p></noscript>
    </div>
  </Launchpad>
</Base>

<style>
  .lp-loading { display: grid; justify-items: center; gap: 10px; padding: 96px 16px; color: var(--c-ink-3); text-align: center; }
  .lp-loading img { width: 96px; height: auto; }
</style>
