---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Toolkit from '../components/home/Toolkit.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import HolderAccess from '../components/HolderAccess.astro';
import LaunchpadPromo from '../components/home/LaunchpadPromo.astro';
import FAQ from '../components/FAQ.astro';
import { faq } from '../content/site-content';
---
<Base
  title="usemoche · Meet Moche, your crypto research companion"
  description="Trading signals, token and wallet checks, and tools to follow the wallets that matter. Mention @usemoche on X to get started."
  current="home"
  preloadHero
>
  <Hero />
  <Toolkit />
  <HowItWorks />
  <HolderAccess />

  <LaunchpadPromo />

  <FAQ items={faq} intro="Short answers to the most common questions. Details that aren’t final yet are marked as such." />
</Base>
